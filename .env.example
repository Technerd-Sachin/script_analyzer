# Copy to .env and chmod 600. Never commit .env.
# Service auth for the API (any long random string). The UI sends it as X-API-Key.
BSA_API_KEY=[BSA_API_KEY]
# Optional: contact string for the Wikipedia User-Agent used by `bsa corpus build`.
BSA_CONTACT=[YOUR_EMAIL]
# Optional: YouTube Data API key for `bsa trends youtube`.
YOUTUBE_API_KEY=
# Optional: TMDB API key (non-commercial terms).
TMDB_API_KEY=
